+ * Fields default to -1 so a parse failure is distinguishable from root. */
+static void read_status_ids(int *ruid, int *euid, int *suid, int *fsuid,
+                            int *rgid, int *egid, int *sgid, int *fsgid)
+{
+    FILE *f = fopen("/proc/self/status", "r");
+    char line[256];
+
+    *ruid = *euid = *suid = *fsuid = -1;
+    *rgid = *egid = *sgid = *fsgid = -1;
+    if (!f)
+        return;
+    while (fgets(line, sizeof(line), f))
+    {
+        if (!strncmp(line, "Uid:", 4))
+            (void)sscanf(line, "Uid: %d %d %d %d",
+                         ruid, euid, suid, fsuid);
+        else if (!strncmp(line, "Gid:", 4))
+            (void)sscanf(line, "Gid: %d %d %d %d",
+                         rgid, egid, sgid, fsgid);
+    }
+    fclose(f);
+}
